const title = "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u062d\u0648\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0648\u0627\u0644\u0633\u064a\u0648 | Mahdi Cr\u00e9ations";
const description = "\u0625\u062c\u0627\u0628\u0627\u062a \u0648\u0627\u0636\u062d\u0629 \u0648\u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0646 \u062c\u0645\u064a\u0639 \u0623\u0633\u0626\u0644\u062a\u0643\u0645 \u062d\u0648\u0644 \u062a\u0643\u0644\u0641\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u062e\u062f\u0645\u0627\u062a \u0633\u064a\u0648 \u062c\u0648\u062c\u0644\u060c \u0645\u062f\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0648\u0637\u0631\u0642 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0644\u062f\u0649 \u0648\u0643\u0627\u0644\u062a\u0646\u0627 \u0628\u0627\u0644\u0645\u063a\u0631\u0628.";
const schemaHtml = "<script type=\"application/ld+json\">\n  {\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n    \"LocalBusiness\",\n    \"ProfessionalService\"\n  ],\n  \"name\": \"Mahdi Cr\u00e9ations\",\n  \"description\": \"Mahdi Cr\u00e9ations\u060c \u0648\u0643\u0627\u0644\u0629 \u0648\u064a\u0628 \u0641\u064a \u0645\u0631\u0627\u0643\u0634 \u0645\u062a\u062e\u0635\u0635\u0629 \u0641\u064a \u0625\u0646\u0634\u0627\u0621 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629\u060c \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b\u060c \u0648\u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0627\u0644\u0631\u0642\u0645\u064a \u0641\u064a \u0627\u0644\u0645\u063a\u0631\u0628.\",\n  \"url\": \"https://mahdicreations.dev/ar/\",\n  \"logo\": \"https://mahdicreations.dev/assets/images/logo.png\",\n  \"image\": \"https://mahdicreations.dev/assets/images/logo.png\",\n  \"telephone\": \"+212674747589\",\n  \"email\": \"mahdicreation.group@gmail.com\",\n  \"priceRange\": \"MAD 5000 - MAD 60000\",\n  \"openingHoursSpecification\": {\n    \"@type\": \"OpeningHoursSpecification\",\n    \"dayOfWeek\": [\n      \"Monday\",\n      \"Tuesday\",\n      \"Wednesday\",\n      \"Thursday\",\n      \"Friday\"\n    ],\n    \"opens\": \"09:00\",\n    \"closes\": \"18:00\"\n  },\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"Av. Mohammed V, Gueliz\",\n    \"addressLocality\": \"Marrakech\",\n    \"postalCode\": \"40000\",\n    \"addressCountry\": \"MA\"\n  },\n  \"geo\": {\n    \"@type\": \"GeoCoordinates\",\n    \"latitude\": 31.6295,\n    \"longitude\": -7.9811\n  },\n  \"sameAs\": [\n    \"https://instagram.com/mahdicreations\",\n    \"https://facebook.com/mahdicreations\",\n    \"https://linkedin.com/company/mahdicreations\"\n  ]\n}\n  </script>\n<script type=\"application/ld+json\">\n  {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0645\u0627 \u0647\u064a \u0623\u0633\u0639\u0627\u0631 \u0648\u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0644\u062f\u0649 Mahdi Cr\u00e9ations\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0643\u0644 \u0645\u0634\u0631\u0648\u0639 \u0641\u0631\u064a\u062f \u0645\u0646 \u0646\u0648\u0639\u0647 \u0648\u064a\u062e\u0636\u0639 \u0644\u062a\u0633\u0639\u064a\u0631 \u0645\u062e\u0635\u0635 \u064a\u062a\u0646\u0627\u0633\u0628 \u0645\u0639 \u0623\u0647\u062f\u0627\u0641\u0643 \u0648\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643 \u0627\u0644\u062a\u0642\u0646\u064a\u0629. \u0628\u0639\u062f \u062f\u0631\u0627\u0633\u0629 \u0645\u0648\u0627\u0635\u0641\u0627\u062a\u0643 \u0623\u0648 \u062e\u0644\u0627\u0644 \u0627\u0633\u062a\u0634\u0627\u0631\u062a\u0646\u0627 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629\u060c \u0646\u0642\u062f\u0645 \u0644\u0643 \u0639\u0631\u0636\u0627\u064b \u062a\u062c\u0627\u0631\u064a\u0627\u064b \u0648\u0627\u0636\u062d\u0627\u064b \u0648\u0645\u0641\u0635\u0644\u0627\u064b.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0645\u0627 \u0647\u064a \u0645\u062a\u0648\u0633\u0637 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643\u0645\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u064a\u0633\u062a\u063a\u0631\u0642 \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062a\u0639\u0631\u064a\u0641\u064a \u0648\u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0639\u0627\u062f\u0629\u064b \u0645\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u0646 \u0625\u0644\u0649 3 \u0623\u0633\u0627\u0628\u064a\u0639 \u0644\u0644\u062a\u0635\u0645\u064a\u0645 \u0628\u0639\u062f \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0642\u062f \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0631\u0633\u0648\u0645\u064a\u0629/\u0627\u0644\u0646\u0635\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643. \u064a\u0633\u062a\u063a\u0631\u0642 \u0645\u0648\u0642\u0639 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u0646 4 \u0625\u0644\u0649 6 \u0623\u0633\u0627\u0628\u064a\u0639\u060c \u0648\u0642\u062f \u064a\u062a\u0637\u0644\u0628 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0645\u0639\u0642\u062f \u0645\u0646 8 \u0625\u0644\u0649 12 \u0623\u0633\u0628\u0648\u0639\u0627\u064b \u0644\u0644\u062a\u0637\u0648\u064a\u0631.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0647\u0644 \u062a\u0642\u062f\u0645\u0648\u0646 \u062e\u062f\u0645\u0627\u062a\u0643\u0645 \u062e\u0627\u0631\u062c \u0645\u0631\u0627\u0643\u0634\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f. \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646 \u0648\u0643\u0627\u0644\u0629 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0646\u0627 \u0645\u0642\u0631\u0647\u0627 \u0641\u064a \u0645\u0631\u0627\u0643\u0634\u060c \u0641\u0625\u0646\u0646\u0627 \u0646\u0639\u0645\u0644 \u0645\u0639 \u0639\u0645\u0644\u0627\u0621 \u0641\u064a \u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 \u0627\u0644\u0645\u063a\u0631\u0628 (\u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0628\u064a\u0636\u0627\u0621\u060c \u0627\u0644\u0631\u0628\u0627\u0637\u060c \u0637\u0646\u062c\u0629\u060c \u0623\u0643\u0627\u062f\u064a\u0631\u060c \u0641\u0627\u0633) \u0648\u0643\u0630\u0644\u0643 \u062f\u0648\u0644\u064a\u0627\u064b (\u0641\u0631\u0646\u0633\u0627\u060c \u0628\u0644\u062c\u064a\u0643\u0627\u060c \u0633\u0648\u064a\u0633\u0631\u0627\u060c \u0625\u0633\u0628\u0627\u0646\u064a\u0627). \u062a\u064f\u0639\u0642\u062f \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u0627\u062a \u0639\u0628\u0631 \u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0648\u0627\u0644\u0647\u0627\u062a\u0641 \u0628\u0637\u0631\u064a\u0642\u0629 \u0633\u0644\u0633\u0629 \u0648\u0634\u0641\u0627\u0641\u0629.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0645\u0627\u0630\u0627 \u062a\u062a\u0636\u0645\u0646 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0647\u0630\u0647 \u0645\u0631\u0627\u062c\u0639\u0629 \u0634\u0627\u0645\u0644\u0629 \u062a\u0642\u062f\u0645 \u062f\u0648\u0646 \u0623\u064a \u0627\u0644\u062a\u0632\u0627\u0645 \u0645\u0646 \u062c\u0627\u0646\u0628\u0643. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0645\u0648\u0642\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0628\u0627\u0644\u0641\u0639\u0644\u060c \u0641\u0646\u062d\u0646 \u0646\u0642\u0648\u0645 \u0628\u062a\u062d\u0644\u064a\u0644 \u0623\u062f\u0627\u0626\u0647\u060c \u0648\u0646\u0642\u0627\u0637 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647 \u0639\u0644\u0649 \u062c\u0648\u062c\u0644\u060c \u0648\u0627\u0633\u062a\u062c\u0627\u0628\u062a\u0647 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629\u060c \u0648\u0623\u0645\u0627\u0646\u0647. \u062b\u0645 \u0646\u0642\u062f\u0645 \u062a\u0642\u0631\u064a\u0631\u0627\u064b \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u062e\u0637\u0629 \u0639\u0645\u0644 \u0645\u0644\u0645\u0648\u0633\u0629 \u0644\u062a\u062d\u0633\u064a\u0646\u0647.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0647\u0644 \u062a\u0642\u062f\u0645\u0648\u0646 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0641\u0646\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0646\u0639\u0645\u060c \u0646\u0642\u062f\u0645 \u0639\u0642\u0648\u062f \u0635\u064a\u0627\u0646\u0629 \u0633\u0646\u0648\u064a\u0629 \u0644\u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0623\u062f\u0627\u062a\u0643 \u0627\u0644\u0631\u0642\u0645\u064a\u0629. \u064a\u0634\u0645\u0644 \u0630\u0644\u0643 \u0646\u0633\u062e\u0627\u064b \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0623\u0633\u0628\u0648\u0639\u064a\u0629 \u0644\u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643\u060c \u0648\u062a\u0637\u0628\u064a\u0642 \u062a\u0635\u062d\u064a\u062d\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0646\u060c \u0648\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u0636\u0627\u0641\u0627\u062a \u0648\u0627\u0644\u062e\u0627\u062f\u0645\u060c \u0641\u0636\u0644\u0627\u064b \u0639\u0646 \u0631\u0635\u064a\u062f \u0633\u0627\u0639\u0627\u062a \u0644\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0628\u0633\u064a\u0637\u0629.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0645\u0627 \u0647\u064a \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062f\u0639\u0645\u0648\u0646\u0647\u0627\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0646\u062a\u0639\u0627\u0648\u0646 \u0645\u0639 \u0642\u0627\u0639\u062f\u0629 \u0639\u0645\u0644\u0627\u0621 \u0645\u062a\u0646\u0648\u0639\u0629. \u0644\u0642\u062f \u0637\u0648\u0631\u0646\u0627 \u062e\u0628\u0631\u0629 \u0642\u0648\u064a\u0629 \u0641\u064a \u062f\u0639\u0645 \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 (\u0627\u0644\u0641\u0646\u0627\u062f\u0642\u060c \u0631\u064a\u0627\u0636 \u0627\u0644\u0641\u0627\u062e\u0631\u0629 \u0641\u064a \u0645\u0631\u0627\u0643\u0634\u060c \u062f\u0648\u0631 \u0627\u0644\u0636\u064a\u0627\u0641\u0629)\u060c \u0648\u0627\u0644\u0648\u0643\u0627\u0644\u0627\u062a \u0627\u0644\u0639\u0642\u0627\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u0643\u0627\u062a\u0628 \u0627\u0644\u0645\u0647\u0646\u064a\u0629 (\u0645\u062d\u0627\u0645\u0648\u0646\u060c \u0639\u064a\u0627\u062f\u0627\u062a)\u060c \u0648\u0627\u0644\u062d\u0631\u0641\u064a\u064a\u0646 \u0627\u0644\u0641\u0646\u064a\u064a\u0646 \u0627\u0644\u0645\u062d\u0644\u064a\u064a\u0646\u060c \u0648\u0645\u062a\u0627\u062c\u0631 \u0627\u0644\u0623\u0632\u064a\u0627\u0621 \u0648\u0645\u0633\u062a\u062d\u0636\u0631\u0627\u062a \u0627\u0644\u062a\u062c\u0645\u064a\u0644 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"\u0643\u064a\u0641 \u0633\u064a\u062a\u0645 \u062a\u062d\u0633\u064a\u0646 \u0645\u0648\u0642\u0639\u064a \u0644\u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0639\u0644\u0649 \u062c\u0648\u062c\u0644\u061f\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"\u0645\u0646\u0630 \u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0646\u0637\u0628\u0642 \u0623\u0641\u0636\u0644 \u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0627\u0644\u0633\u064a\u0648: \u0643\u0648\u062f \u062f\u0644\u0627\u0644\u064a \u0645\u062d\u0633\u0651\u0646\u060c \u0648\u0639\u0644\u0627\u0645\u0627\u062a HTML \u0646\u0638\u064a\u0641\u0629\u060c \u0648\u0635\u0648\u0631 \u0645\u0636\u063a\u0648\u0637\u0629\u060c \u0648\u062a\u0643\u0648\u064a\u0646 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 HTTPS\u060c \u0648\u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0641\u064a Google Search Console. \u0643\u0645\u0627 \u0646\u0642\u062f\u0645 \u0628\u0627\u0642\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0628\u062d\u062b \u0634\u0647\u0631\u064a\u0629 \u0645\u062a\u0642\u062f\u0645\u0629 \u0644\u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0627\u0644\u062a\u0646\u0627\u0641\u0633\u064a\u0629.\"\n      }\n    }\n  ]\n}\n  </script>";
