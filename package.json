{
  "name": "mahdicreation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify && tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "build:js": "terser assets/js/main.js -c -m -o assets/js/main.min.js --source-map \"url=main.min.js.map\"",
    "dev": "concurrently \"npm:dev:css\" \"npm:serve\"",
    "dev:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --watch",
    "serve": "serve . -l 4000"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2"
  }
}
