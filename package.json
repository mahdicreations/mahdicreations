{
  "name": "mahdicreation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4000",
    "start": "astro dev --port 4000",
    "build": "astro build",
    "preview": "astro preview --port 4000",
    "legacy:build": "npm run legacy:css && npm run legacy:js",
    "legacy:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify",
    "legacy:js": "terser assets/js/main.js -c -m -o assets/js/main.min.js --source-map \"url=main.min.js.map\""
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.4.0",
    "concurrently": "^10.0.5",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2"
  }
}
