{
  "name": "mahdicreation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:html": "node build.js",
    "build:css": "npx tailwindcss -c src/tailwind.config.js -i src/input.css -o dist/assets/css/style.css --minify",
